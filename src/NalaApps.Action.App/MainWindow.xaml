<Window x:Class="NalaApps.Action.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NalaApps Action"
        Width="520"
        Height="760"
        MinWidth="460"
        MinHeight="640"
        MaxWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,4,4,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="NalaApps Action"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="내가 한 작업을 기억하고 다시 실행해요"
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="48"
                        Height="48"
                        CornerRadius="16"
                        Background="#E8F3FF"
                        VerticalAlignment="Center">
                    <TextBlock Text="▶"
                               FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="24"
                    Padding="18"
                    Margin="0,0,0,14"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="액션 이름"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox x:Name="ActionNameTextBox"
                             Margin="0,9,0,14"
                             Text="새 액션" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="새 액션"
                                Style="{StaticResource PillButtonStyle}"
                                Click="NewAction_Click" />
                        <Button Grid.Column="1"
                                Content="불러오기"
                                Style="{StaticResource PillButtonStyle}"
                                Click="LoadAction_Click" />
                        <Button Grid.Column="2"
                                Content="저장"
                                Style="{StaticResource PrimaryPillButtonStyle}"
                                Click="SaveAction_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="24"
                    Padding="18"
                    Margin="0,0,0,14"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="280" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="기록된 단계"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="실행할 작업 순서를 확인하세요"
                                       Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="#F2F2F7"
                                CornerRadius="12"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StepCountText"
                                       Text="0개"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Height="1"
                            Background="{StaticResource DividerBrush}"
                            Margin="0,15,0,12" />

                    <ListBox x:Name="StepsList"
                             Grid.Row="2" />

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="현재 상태"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StatusText"
                                       Text="준비"
                                       Margin="0,3,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="선택 삭제"
                                Style="{StaticResource DangerPillButtonStyle}"
                                Click="DeleteStep_Click" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="24"
                    Padding="18"
                    Margin="0,0,0,14"
                    Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="빠른 실행"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Text="녹화하고, 확인하고, 다시 실행하세요"
                               Margin="0,4,0,13"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" />

                    <Button x:Name="RecordButton"
                            Content="●  녹화 시작"
                            Height="48"
                            Style="{StaticResource PrimaryPillButtonStyle}"
                            Click="RecordButton_Click" />

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="▶  실행"
                                Height="44"
                                Style="{StaticResource PillButtonStyle}"
                                Click="PlayButton_Click" />
                        <Button Grid.Column="1"
                                Content="■  긴급 중지"
                                Height="44"
                                Style="{StaticResource DangerPillButtonStyle}"
                                Click="StopButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="4"
                    Background="#E8F3FF"
                    CornerRadius="18"
                    Padding="14,11"
                    Margin="4,0,4,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌨"
                               FontSize="17"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1"
                               Text="긴급 중지 단축키  Ctrl + Shift + F12"
                               FontSize="13"
                               Foreground="#24639B"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
