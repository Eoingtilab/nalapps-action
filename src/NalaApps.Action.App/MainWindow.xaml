<Window x:Class="NalaApps.Action.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NalaApps Action"
        Width="520"
        Height="820"
        MinWidth="460"
        MinHeight="760"
        MaxWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,4,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NalaApps Action" FontSize="27" FontWeight="Bold" />
                <TextBlock Text="내가 한 작업을 기억하고 다시 실행해요"
                           Margin="0,4,0,0" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="16"
                    Background="#E8F3FF" VerticalAlignment="Center">
                <TextBlock Text="▶" FontSize="18" Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="24"
                Padding="18" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="액션 이름" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox x:Name="ActionNameTextBox" Margin="0,9,0,12" Text="새 액션" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="새 액션" Style="{StaticResource PillButtonStyle}" Click="NewAction_Click" />
                    <Button Grid.Column="1" Content="불러오기" Style="{StaticResource PillButtonStyle}" Click="LoadAction_Click" />
                    <Button Grid.Column="2" Content="저장" Style="{StaticResource PrimaryPillButtonStyle}" Click="SaveAction_Click" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Grid.Column="0" Content="●  녹화 시작" Height="46"
                            Style="{StaticResource PrimaryPillButtonStyle}" Click="RecordButton_Click" />
                    <Button x:Name="PlayButton" Grid.Column="1" Content="▶  실행" Height="46"
                            Style="{StaticResource PillButtonStyle}" Click="PlayButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="24"
                Padding="18" Margin="0,0,0,14" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="기록된 단계" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="더블클릭하여 편집하거나 순서를 변경하세요"
                                   Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#F2F2F7" CornerRadius="12"
                            Padding="10,6" VerticalAlignment="Center">
                        <TextBlock x:Name="StepCountText" Text="0개" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,13,0,10" />

                <ListBox x:Name="StepsList" Grid.Row="2"
                         MinHeight="190"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="StepsList_MouseDoubleClick" />

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="＋ 단계 추가" Style="{StaticResource PillButtonStyle}" Click="AddStep_Click" />
                    <Button Grid.Column="1" Content="편집" Style="{StaticResource PillButtonStyle}" Click="EditStep_Click" />
                    <Button Grid.Column="2" Content="↑" Width="42" Style="{StaticResource PillButtonStyle}" Click="MoveUp_Click" />
                    <Button Grid.Column="3" Content="↓" Width="42" Style="{StaticResource PillButtonStyle}" Click="MoveDown_Click" />
                    <Button Grid.Column="4" Content="삭제" Style="{StaticResource DangerPillButtonStyle}" Click="DeleteStep_Click" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="현재 상태" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatusText" Text="준비" Margin="0,3,0,0"
                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Ctrl + Shift + F12  긴급 중지"
                               FontSize="11.5" Foreground="#24639B" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#E8F3FF" CornerRadius="18" Padding="14,10" Margin="4,0,4,6">
            <TextBlock Text="저장하지 않아도 바로 실행할 수 있습니다. 실행 중에는 실행 버튼이 중지 버튼으로 바뀝니다."
                       FontSize="12.5" Foreground="#24639B" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
