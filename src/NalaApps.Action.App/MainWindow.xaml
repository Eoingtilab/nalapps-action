<Window x:Class="NalaApps.Action.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NalaApps Action"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="NalaApps Action" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Windows 작업을 기록하고 다시 실행합니다." Margin="0,4,0,0" Foreground="#64748B" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="새 액션" Click="NewAction_Click" />
                    <Button Content="불러오기" Click="LoadAction_Click" />
                    <Button Content="저장" Click="SaveAction_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="액션" FontSize="18" FontWeight="SemiBold" />
                    <TextBox x:Name="ActionNameTextBox" Margin="0,12,0,12" Text="새 액션" />
                    <TextBlock Text="현재 상태" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="준비" Margin="0,6,0,0" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="기록 단계" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="StepCountText" Text="0개" HorizontalAlignment="Right" Foreground="#64748B" />
                    </DockPanel>
                    <ListBox x:Name="StepsList" Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16">
                <StackPanel>
                    <TextBlock Text="단계 속성" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="단계를 선택하면 상세 정보가 표시됩니다." Margin="0,12,0,0" Foreground="#64748B" TextWrapping="Wrap" />
                    <Button Content="선택 단계 삭제" Margin="0,18,0,0" Click="DeleteStep_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock Text="긴급 중지: Ctrl + Shift + F12" VerticalAlignment="Center" Foreground="#64748B" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RecordButton" Content="녹화 시작" Click="RecordButton_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                    <Button Content="실행" Click="PlayButton_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                    <Button Content="긴급 중지" Click="StopButton_Click" Background="{StaticResource DangerBrush}" Foreground="White" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
