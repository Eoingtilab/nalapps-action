<Window x:Class="NalaApps.Action.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NalaApps Action"
        Width="520"
        Height="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        Background="White"
        Opacity="0">
    <Grid Background="White">
        <Image Source="/NalaApps.Action;component/Assets/NalaApps.Action.Splash.jpg"
               Stretch="Fill"
               SnapsToDevicePixels="True" />
    </Grid>
</Window>
